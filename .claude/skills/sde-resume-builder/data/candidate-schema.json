{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate Profile",
  "description": "A comprehensive schema for an SDE candidate profile used to generate high-quality resumes.",
  "type": "object",
  "properties": {
    "identity": {
      "type": "object",
      "description": "Personal identification and contact information.",
      "properties": {
        "fullName": { "type": "string", "description": "Full name of the candidate." },
        "email": { "type": "string", "format": "email", "description": "Professional email address." },
        "phone": { "type": "string", "description": "Contact phone number." },
        "location": { "type": "string", "description": "Current location (e.g., 'San Francisco, CA')." },
        "summary": { "type": "string", "description": "Professional summary or objective statement." },
        "links": {
          "type": "object",
          "properties": {
            "linkedin": { "type": "string", "format": "uri", "description": "LinkedIn profile URL." },
            "github": { "type": "string", "format": "uri", "description": "GitHub profile URL." },
            "portfolio": { "type": "string", "format": "uri", "description": "Personal portfolio or blog URL." },
            "twitter": { "type": "string", "format": "uri", "description": "Twitter/X profile URL." }
          }
        }
      },
      "required": ["fullName", "email"]
    },
    "experience": {
      "type": "array",
      "description": "Professional work experience.",
      "items": {
        "type": "object",
        "properties": {
          "company": { "type": "string", "description": "Name of the employer." },
          "position": { "type": "string", "description": "Job title held." },
          "location": { "type": "string", "description": "Location of the company (e.g., 'Remote', 'New York, NY')." },
          "startDate": { "type": "string", "description": "Start date of employment (e.g., 'YYYY-MM' or 'Month YYYY')." },
          "endDate": { "type": "string", "description": "End date of employment (e.g., 'YYYY-MM' or 'Present')." },
          "isCurrent": { "type": "boolean", "description": "Whether the candidate is currently employed here." },
          "highlights": {
            "type": "array",
            "description": "Bullet points describing achievements and responsibilities.",
            "items": { "type": "string" }
          },
          "technologies": {
            "type": "array",
            "description": "Key technologies used in this role.",
            "items": { "type": "string" }
          }
        },
        "required": ["company", "position", "startDate", "endDate", "highlights"]
      }
    },
    "education": {
      "type": "array",
      "description": "Academic qualifications.",
      "items": {
        "type": "object",
        "properties": {
          "institution": { "type": "string", "description": "Name of the school or university." },
          "degree": { "type": "string", "description": "Degree obtained (e.g., 'B.S.', 'M.S.', 'PhD')." },
          "major": { "type": "string", "description": "Field of study (e.g., 'Computer Science')." },
          "location": { "type": "string", "description": "Location of the institution." },
          "graduationDate": { "type": "string", "description": "Graduation date or expected graduation date." },
          "gpa": { "type": "string", "description": "Grade Point Average (optional)." },
          "honors": {
            "type": "array",
            "description": "Academic honors or awards (e.g., 'Cum Laude', 'Dean's List').",
            "items": { "type": "string" }
          }
        },
        "required": ["institution", "degree", "major", "graduationDate"]
      }
    },
    "skills": {
      "type": "object",
      "description": "Categorized technical skills.",
      "properties": {
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "category": { "type": "string", "description": "Skill category (e.g., 'Languages', 'Frameworks', 'Cloud Services')." },
              "skills": {
                "type": "array",
                "description": "List of skills within this category.",
                "items": { "type": "string" }
              }
            },
            "required": ["category", "skills"]
          }
        }
      }
    },
    "projects": {
      "type": "array",
      "description": "Personal or open-source projects.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Project name." },
          "description": { "type": "string", "description": "Brief overview of the project." },
          "link": { "type": "string", "format": "uri", "description": "URL to the project or repository." },
          "technologies": {
            "type": "array",
            "description": "Technologies used in the project.",
            "items": { "type": "string" }
          },
          "highlights": {
            "type": "array",
            "description": "Bullet points highlighting key contributions and outcomes.",
            "items": { "type": "string" }
          },
          "startDate": { "type": "string", "description": "Start date of the project." },
          "endDate": { "type": "string", "description": "End date of the project." }
        },
        "required": ["title", "description", "technologies", "highlights"]
      }
    },
    "achievements": {
      "type": "array",
      "description": "Awards, certifications, and other notable achievements.",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "description": "Title of the achievement or certification." },
          "issuer": { "type": "string", "description": "Organization that issued the achievement." },
          "date": { "type": "string", "description": "Date received." },
          "description": { "type": "string", "description": "Short description of the achievement." },
          "link": { "type": "string", "format": "uri", "description": "URL to verify the achievement." }
        },
        "required": ["title", "issuer", "date"]
      }
    }
  },
  "required": ["identity", "experience", "education", "skills"]
}
